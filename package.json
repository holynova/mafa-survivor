{
  "name": "mafa-survivor",
  "version": "0.1.0-alpha.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "assets:fetch": "python3 tools/import-assets.py",
    "assets:check": "node tools/check-assets.mjs",
    "build:release": "node tools/check-assets.mjs --release && npm run build",
    "assets:visual-check": ".venv/bin/python tools/check-visual-assets.py",
    "assets:audio-check": "python3 tools/check-audio.py",
    "build:pages": "node tools/build-pages.mjs",
    "simulate": "node tools/simulate.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
